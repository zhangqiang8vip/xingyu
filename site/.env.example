# Environment selection is automatic:
# `npm run dev` uses the persistent development database.
# Hosted builds default to the separate production database.

# Local development only: choose a strong, unique password and random session secret.
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
MCP_WRITE_TOKEN=replace-with-a-separate-random-writing-token

# Hosted Sites: comma-separated ChatGPT account emails allowed to administer the blog.
ADMIN_EMAILS=admin@example.com
