{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xingyu-blog",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "vars": {
    "APP_ENV": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xingyu-production",
      "database_id": "3d1f4b08-a1f8-4ba3-a876-2ba4b3a10b16"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "routes": [
    {
      "pattern": "zhangwansen.click/*",
      "zone_name": "zhangwansen.click"
    }
  ],
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ]
}
